# =============================================================================
# vaultspec-core environment variables
# =============================================================================
#
# Copy this file to `.env.local` and uncomment only the values you need.
# This file documents every variable declared in
# `vaultspec_core.config.CONFIG_REGISTRY`, and nothing else: the VAULTSPEC_*
# settings vaultspec-core owns, the external conventions it honours, and the
# internal marker it sets for its own child processes.
#
# Installed commands:
#   vaultspec-core
#   python -m vaultspec_core.mcp_server.app  (MCP server)
#
# =============================================================================


# -----------------------------------------------------------------------------
# Workspace
# -----------------------------------------------------------------------------

# Workspace root directory used by the CLI and MCP runtime.
# Type: Path | Default: current working directory
# VAULTSPEC_TARGET_DIR=.


# -----------------------------------------------------------------------------
# Vault Layout
# -----------------------------------------------------------------------------

# Vault document directory name relative to the workspace root.
# Type: String | Default: .vault
# VAULTSPEC_DOCS_DIR=.vault

# Subdirectory of the vault that holds the auto-generated feature indexes
# (<feature>.index.md).
# Type: String | Default: index
# VAULTSPEC_INDEX_DIR=index

# Framework resource directory name relative to the workspace root.
# Type: String | Default: .vaultspec
# VAULTSPEC_FRAMEWORK_DIR=.vaultspec


# -----------------------------------------------------------------------------
# Tool Directories
# -----------------------------------------------------------------------------

# Claude configuration directory name relative to the workspace root.
# Type: String | Default: .claude
# VAULTSPEC_CLAUDE_DIR=.claude

# Gemini configuration directory name relative to the workspace root.
# Type: String | Default: .gemini
# VAULTSPEC_GEMINI_DIR=.gemini

# Antigravity configuration directory name relative to the workspace root.
# Type: String | Default: .agents
# VAULTSPEC_ANTIGRAVITY_DIR=.agents


# -----------------------------------------------------------------------------
# Editor
# -----------------------------------------------------------------------------

# Editor command. Interactive creation of a rule, skill, agent or trigger
# opens it, or zed -w when unset. The edit verbs consult it after the --editor
# flag and the project config key, before VISUAL and EDITOR.
# Type: String | Default: zed -w
# VAULTSPEC_EDITOR=zed -w

# Honoured convention, not owned by vaultspec-core: the editor command the
# edit verbs consult after VAULTSPEC_EDITOR.
# Type: String | Default: unset
# VISUAL=

# Honoured convention, not owned by vaultspec-core: the editor command the
# edit verbs consult after VISUAL. With none of the three set, they use vi.
# Type: String | Default: unset
# EDITOR=


# -----------------------------------------------------------------------------
# I/O
# -----------------------------------------------------------------------------

# Subprocess stdout read buffer size in bytes.
# Type: Integer (>= 1) | Default: 8192
# VAULTSPEC_IO_BUFFER_SIZE=8192

# Maximum terminal output captured from subprocesses in bytes.
# Type: Integer (>= 1) | Default: 1000000
# VAULTSPEC_TERMINAL_OUTPUT_LIMIT=1000000


# -----------------------------------------------------------------------------
# Concurrency
# -----------------------------------------------------------------------------

# Total seconds a single advisory-lock acquisition may wait before reporting a
# timeout. Covers both the in-process thread layer and the cross-process OS
# layer combined.
# Type: Float (>= 0) | Default: 120.0
# VAULTSPEC_LOCK_TIMEOUT_SECONDS=120.0


# -----------------------------------------------------------------------------
# Vault Search
# -----------------------------------------------------------------------------

# Optional hosted vault search with TypeSafe Jev. When set, vault search
# ranks vault documents against the query and returns them with their
# answering excerpts. This sends queries and vault document content to
# https://api.typesafe.ai and incurs API usage. No separate enable flag.
# Read from the process environment first. A workspace-root .env supplies it
# only when vaultspec-core runs from the workspace's own environment (its
# project virtual environment) in dependency or dev mode, never for a globally
# installed tool.
# Unset or blank means no TypeSafe calls; vault search then reports that it is
# not configured and names the vaultspec-rag search to run instead.
# Never commit a credential here.
# Type: String (secret) | Default: unset
# VAULTSPEC_CORE_TYPESAFE_API_KEY=


# -----------------------------------------------------------------------------
# CLI Output
# -----------------------------------------------------------------------------

# Root log level when no --debug, --quiet or explicit level is given, for
# example DEBUG, INFO or WARNING. An unknown name means INFO.
# Type: String | Default: INFO
# VAULTSPEC_LOG_LEVEL=INFO

# Indents --json output. Any value other than 0, false, no, off or blank turns
# it on; unset, the envelope is one compact line.
# Type: String | Default: unset
# VAULTSPEC_JSON_PRETTY=1

# Set to 1 to drop the Next actions block commands print after their report;
# equivalent to --no-hints. Only the exact value 1 counts.
# Type: String | Default: unset
# VAULTSPEC_NO_HINTS=1

# Honoured convention, not owned by vaultspec-core: set to any value, even
# blank, to disable colour in console output.
# Type: Presence | Default: unset
# NO_COLOR=1

# Honoured convention, not owned by vaultspec-core: console width. When set,
# the console library honours it; when unset, the width is queried from the
# terminal once at startup.
# Type: Integer | Default: unset
# COLUMNS=120


# -----------------------------------------------------------------------------
# Unattended Runs
# -----------------------------------------------------------------------------

# Set to any value, even blank, to declare that no operator is watching, as CI
# does: repository triggers awaiting approval are skipped instead of prompted
# for.
# Type: Presence | Default: unset
# VAULTSPEC_NON_INTERACTIVE=1

# Honoured convention, not owned by vaultspec-core: set to any value, even
# blank, by CI systems, with the same effect as VAULTSPEC_NON_INTERACTIVE.
# Type: Presence | Default: unset
# CI=true


# -----------------------------------------------------------------------------
# MCP Server
# -----------------------------------------------------------------------------

# Lifetime watchdog of the MCP server, on by default. 0, false, off or no
# disables it, leaving stdin EOF as the only exit path.
# Type: String | Default: on
# VAULTSPEC_STDIO_WATCHDOG=0

# Internal, set by vaultspec-core itself: the MCP invoke gateway sets it on
# every CLI process it spawns. Any non-empty value marks the process as having
# no terminal, so it refuses to open an editor. Not an operator setting.
# Type: String | Default: unset
# VAULTSPEC_MCP_GATEWAY_INVOCATION=1


# -----------------------------------------------------------------------------
# Provider Homes
# -----------------------------------------------------------------------------

# Honoured convention, not owned by vaultspec-core: Claude Code's configuration
# home, whose .claude.json holds user-scope MCP servers.
# Type: Path | Default: home directory
# CLAUDE_CONFIG_DIR=~/.config/claude

# Honoured convention, not owned by vaultspec-core: Codex's home, whose
# config.toml holds user-scope MCP servers.
# Type: Path | Default: ~/.codex
# CODEX_HOME=~/.codex


# =============================================================================
# Development harness only
# =============================================================================
#
# Read by the `just` recipes and the dev/ tooling of this repository, never by
# the installed vaultspec-core. Declared in `dev.environment.HARNESS_REGISTRY`.
# NO_COLOR and CODEX_HOME are honoured by the harness too; they are documented
# once, above.
#
# =============================================================================


# -----------------------------------------------------------------------------
# Harness Switches
# -----------------------------------------------------------------------------

# Directory the dependency audit writes its JSON report into. Unset or blank
# writes nothing.
# Type: Path | Default: unset
# VAULTSPEC_CI_REPORTS=.ci-reports

# Set by CI. Makes a fix recipe report drift when it had to change something.
# Type: Presence | Default: unset
# VAULTSPEC_FIX_STRICT=1

# Set by a test lane that is legitimately allowed to collect nothing.
# Type: Presence | Default: unset
# VAULTSPEC_ALLOW_EMPTY_SELECTION=1

# 1, true, yes or on turns on the NDJSON event stream of just init, so the
# recipe stays argument-free.
# Type: Boolean | Default: unset
# VAULTSPEC_INIT_JSON=1

# 1, true, yes or on makes just init run every step, ignoring its stamp.
# Type: Boolean | Default: unset
# VAULTSPEC_INIT_FORCE=1

# Any non-blank value streams every harness step and echoes its command.
# Type: String | Default: unset
# VAULTSPEC_VERBOSE=1


# -----------------------------------------------------------------------------
# Honoured Conventions
# -----------------------------------------------------------------------------

# Not owned by vaultspec-core: set by the GitHub Actions runner. When set,
# downloaded tools are cached under it instead of beside the project's .venv.
# Type: Path | Default: unset
# RUNNER_TOOL_CACHE=

# Not owned by vaultspec-core: set to true by the GitHub Actions runner.
# Linters then also emit their findings as workflow annotations.
# Type: String | Default: unset
# GITHUB_ACTIONS=true

# Not owned by vaultspec-core: Python's stream encoding. The harness sets it to
# utf-8 for itself and every Python child unless it is already set.
# Type: String | Default: utf-8 (set by the harness)
# PYTHONIOENCODING=utf-8
